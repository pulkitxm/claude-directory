  <div class="min-h-screen bg-base-100 dark:bg-base-700"><!-- Mobile header --><div class="bg-base-100 dark:bg-base-700"><header class="px-2 py-2 bg-white border-b lg:hidden border-base-200 dark:border-base-800 dark:bg-base-900"><div class="flex items-center justify-between gap-4"><div class="inline-flex items-center bg-base-100 dark:bg-base-800 rounded-full p-0.5 transition-colors duration-200 gap-1 " data-theme-toggle-container><!-- System/Auto Button --><button class="flex items-center font-medium justify-center transition-all rounded-full duration-300 focus:ring-2 focus:ring-none focus:ring-offset-1 focus:ring-offset-white dark:focus:ring-offset-base-900 text-base-900 bg-base-100 hover:bg-base-100 focus:ring-base-100 dark:text-white dark:bg-base-800 dark:hover:bg-base-700 dark:focus:ring-base-800 size-6 py-2 text-xs" data-theme-option="system" role="radio" aria-checked="false" aria-label="Use system theme" title="System theme"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon size-3" slot="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 5a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1v-10z"></path><path d="M7 20h10"></path><path d="M9 16v4"></path><path d="M15 16v4"></path></svg></button><!-- Light Button --><button class="flex items-center font-medium justify-center transition-all rounded-full duration-300 focus:ring-2 focus:ring-none focus:ring-offset-1 focus:ring-offset-white dark:focus:ring-offset-base-900 text-base-900 bg-base-100 hover:bg-base-100 focus:ring-base-100 dark:text-white dark:bg-base-800 dark:hover:bg-base-700 dark:focus:ring-base-800 size-6 py-2 text-xs" data-theme-option="light" role="radio" aria-checked="false" aria-label="Light theme" title="Light theme"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon size-3" slot="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"></path><path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7"></path></svg></button><!-- Dark Button --><button class="flex items-center font-medium justify-center transition-all rounded-full duration-300 focus:ring-2 focus:ring-none focus:ring-offset-1 focus:ring-offset-white dark:focus:ring-offset-base-900 text-base-900 bg-base-100 hover:bg-base-100 focus:ring-base-100 dark:text-white dark:bg-base-800 dark:hover:bg-base-700 dark:focus:ring-base-800 size-6 py-2 text-xs" data-theme-option="dark" role="radio" aria-checked="false" aria-label="Dark theme" title="Dark theme"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon size-3" slot="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z"></path></svg></button></div><script type="module">var e={SYSTEM:`system`,LIGHT:`light`,DARK:`dark`};function t(){return window.matchMedia(`(prefers-color-scheme: dark)`).matches?`dark`:`light`}function n(n){let r=n;n===e.SYSTEM&&(r=t()),document.documentElement.classList.toggle(`dark`,r===`dark`)}function r(e){document.querySelectorAll(`[data-theme-option]`).forEach(t=>{let n=t.dataset.themeOption===e;t.setAttribute(`aria-checked`,n?`true`:`false`),n?t.classList.add(`shadow-sm`):t.classList.remove(`shadow-sm`)})}function i(e){localStorage.setItem(`theme`,e),n(e),r(e)}function a(){let t=localStorage.getItem(`theme`)||e.SYSTEM;n(t),r(t)}a(),window.matchMedia(`(prefers-color-scheme: dark)`).addEventListener(`change`,()=>{(localStorage.getItem(`theme`)||e.SYSTEM)===e.SYSTEM&&n(e.SYSTEM)}),document.querySelectorAll(`[data-theme-option]`).forEach(e=>{e.addEventListener(`click`,()=>{let t=e.dataset.themeOption;i(t)})});</script><!-- Trigger Button --><button onclick="document.getElementById('search-modal-mobile').classList.remove('hidden')" class="flex items-center justify-between w-full px-4 py-2 text-xs leading-tight align-middle bg-white border border-transparent dark:bg-base-900 transition duration-300 ease-in-out focus:z-10 h-9 rounded-md text-base-500 ring-1 ring-base-200 dark:ring-base-800 placeholder-base-400 focus:border-accent-500 focus:ring-2 focus:ring-accent-100 focus:outline-none shadow-sm focus:ring-offset-white dark:focus:ring-offset-base-900"><div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon size-4" slot="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path><path d="M21 21l-6 -6"></path></svg><span>Search docs</span></div><kbd class="hidden ml-4 text-sm sm:inline-block text-base-400 dark:text-base-500"><div class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="icon size-4" slot="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M7 9a2 2 0 1 1 2 -2v10a2 2 0 1 1 -2 -2h10a2 2 0 1 1 -2 2v-10a2 2 0 1 1 2 2h-10"></path></svg>K</div></kbd></button><!-- Modal --><div id="search-modal-mobile" class="fixed inset-0 flex items-start justify-center hidden p-6 z-60 bg-black/40 backdrop-blur"><!-- Click-outside area --><div class="absolute inset-0" onclick="document.getElementById('search-modal-mobile').classList.add('hidden')"></div><!-- Modal content --><div class="relative z-50 w-full max-w-md mt-24" onclick="event.stopPropagation()"><!--
      // In case you want  a close button.
      // But it's not necessary, the modal can be closed by clicking outside of it or pressing the ESC key.
   Close button
   <Button
   iconOnly
   size="xs"
   variant="muted"
   class="hidden ml-auto"
   onclick={`document.getElementById('${modalId}').classList.add('hidden')`}
   >
   <RoundedX slot="icon" size="sm" />
  </Button>
  --><!-- Search Input --><div class="relative w-full bg-white dark:bg-base-900 rounded-md"><input id="search-input-mobile" type="text" autofocus placeholder="Search documentation..." class="block w-full py-2 pl-10 text-xs leading-tight align-middle bg-white border border-transparent dark:bg-base-900 transition duration-300 ease-in-out focus:z-10 h-9 rounded-md text-base-500 ring-1 ring-base-200 dark:ring-base-800 placeholder-base-400 focus:border-accent-500 focus:ring-2 focus:ring-accent-100 focus:outline-none shadow-sm focus:ring-offset-white dark:focus:ring-offset-base-900"><div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon size-4 text-base-400" slot="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path><path d="M21 21l-6 -6"></path></svg></div></div><!-- Results --><div id="search-results-mobile" class="flex flex-col w-full overflow-y-auto bg-white dark:bg-base-800 max-h-80 rounded-b-md scrollbar-hide focus:outline-none space-y-1 focus:ring-2 focus:ring-accent-500"></div></div></div><script>(function(){const docs = [{"title":"Accordion","content":"Expandable section UI using native \u003cdetails> for accessibility and progressive enhancement.","category":"components","url":"/docs/components/accordion"},{"title":"Alert","content":"Contextual alert banners for feedback, messaging, or inline warnings.","category":"components","url":"/docs/components/alerts"},{"title":"Badge","content":"Small, contextual indicators for labeling, categorizing, or status messaging.","category":"components","url":"/docs/components/badges"},{"title":"Button","content":"A flexible button component with multiple variants, sizes, and icon support for ZeroIndex","category":"components","url":"/docs/components/buttons"},{"title":"Tabs","content":"An accessible tab interface with buttons and panels for switching between related content.","category":"components","url":"/docs/components/tabs"},{"title":"Text","content":"A flexible typography component for semantic text with custom sizing and styling in ZeroIndex.","category":"components","url":"/docs/components/typography"},{"title":"Wrapper","content":"A utility layout component for wrapping content with standard or prose-style layouts.","category":"components","url":"/docs/components/wrappers"},{"title":"Introduction","content":"Welcome to our documentation. Learn how to get started quickly.","category":"getting-started","url":"/docs/getting-started/introduction"},{"title":"Quick Start Guide","content":"Get up and running in just a few minutes with this quick start guide.","category":"getting-started","url":"/docs/getting-started/quick-start"},{"title":"Frequently Asked Questions","content":"Answers to common questions about using and contributing to our documentation.","category":"help","url":"/docs/help/faq"},{"title":"Sidebar","content":"Understanding the sidebar","category":"navigation","url":"/docs/navigation/sidebar"},{"title":"Sidebar Links","content":"Understanding the sidebar accordion links","category":"navigation","url":"/docs/navigation/sidebar-links"},{"title":"Shiki Code Highlighting","content":"How syntax highlighting and styling works in ZeroIndex","category":"shiki","url":"/docs/shiki/code-highlighter"},{"title":"Shiki anotations usage examples","content":"Simple examples to get you started with basic functionality.","category":"shiki","url":"/docs/shiki/shiki-examples"}];
const inputId = "search-input-mobile";
const resultsId = "search-results-mobile";
const modalId = "search-modal-mobile";

  if (!window.fuseLoaded) {
    const script = document.createElement("script");
    script.src = "https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js";
    script.onload = () => {
      window.fuseLoaded = true;
      window.dispatchEvent(new Event("fuseReady"));
    };
    document.head.appendChild(script);
  }
  function initializeSearch() {
    if (typeof Fuse === "undefined") {
      window.addEventListener("fuseReady", initializeSearch, { once: true });
      return;
    }
    const searchInput = document.getElementById(inputId);
    const resultsContainer = document.getElementById(resultsId);
    const modal = document.getElementById(modalId);
    if (!searchInput || !resultsContainer || !modal) return;
    if (searchInput.dataset.initialized) return;
    searchInput.dataset.initialized = "true";
    const fuse = new Fuse(docs, {
      keys: ["title", "content", "category"],
      threshold: 0.3,
      includeMatches: true,
    });
    function highlightMatches(text, matches = [], key = "") {
      if (!matches || !text) return text;
      const relevant = matches.find((match) => match.key === key);
      if (!relevant || !relevant.indices) return text;
      const indices = [...relevant.indices];
      let result = "";
      let lastIndex = 0;
      for (const [start, end] of indices) {
        result += text.slice(lastIndex, start);
        result += `<mark class="font-medium text-accent-600 bg-accent-50 dark:bg-base-700 dark:text-accent-300">${text.slice(start, end + 1)}</mark>`;
        lastIndex = end + 1;
      }
      result += text.slice(lastIndex);
      return result;
    }
    function renderResults(results, query) {
      if (!query.trim()) {
        resultsContainer.innerHTML = "";
        return;
      }
      if (results.length === 0) {
        resultsContainer.innerHTML = `<div class="block p-4 hover:bg-base-50 text-base-900 dark:text-white dark:hover:bg-base-700  transition-colors">No results for "${query}"</div>`;
      } else {
        resultsContainer.innerHTML = results

          .map((result) => {
            const { title, content, category, url } = result.item;
            const matches = result.matches;
            return `
              <a href="${url}" class="block p-4 hover:bg-base-50 transition-colors dark:hover:bg-base-700">
                <div class="text-sm font-medium text-base-900 dark:text-white">${highlightMatches(title, matches, "title")}</div>
                <div class="mt-1 text-xs capitalize text-base-500 dark:text-base-300">${category}</div>
                <div class="mt-1 text-sm text-base-600 line-clamp-2 dark:text-base-300">${highlightMatches(content, matches, "content")}</div>
              </a>
            `;
          })
          .join("");
      }
    }
    searchInput.addEventListener("input", (e) => {
      const query = e.target.value;
      const results = query.trim() ? fuse.search(query) : [];
      renderResults(results, query);
    });
    searchInput.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        modal.classList.add("hidden");
      }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        modal.classList.add("hidden");
      }
    });
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeSearch);
  } else {
    initializeSearch();
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeSearch);
  } else {
    initializeSearch();
  }

  // CMD+K / CTRL+K shortcut here 👇
  document.addEventListener("keydown", (e) => {
    const isMac = navigator.platform.toUpperCase().indexOf("MAC") >= 0;
    const openKeys = (isMac && e.metaKey) || (!isMac && e.ctrlKey);

    if (openKeys && e.key.toLowerCase() === "k") {
      e.preventDefault();
      const modal = document.getElementById(modalId);
      const input = document.getElementById(inputId);
      if (modal && input) {
        modal.classList.remove("hidden");
        setTimeout(() => input.focus(), 10);
      }
    }
  });
})();</script><button class="flex items-center font-medium justify-center transition-all rounded-full duration-300 focus:ring-2 focus:ring-none focus:ring-offset-1 focus:ring-offset-white dark:focus:ring-offset-base-900 text-base-900 bg-base-100 hover:bg-base-100 focus:ring-base-100 dark:text-white dark:bg-base-800 dark:hover:bg-base-700 dark:focus:ring-base-800 size-9 text-sm shrink-0" id="mobile-menu-toggle" aria-label="Open menu"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon size-4" slot="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M4 8l16 0"></path><path d="M4 16l16 0"></path></svg></button></div></header><div class="flex"><!-- Sidebar --><div id="sidebar-backdrop" class="fixed inset-0 z-40 hidden bg-base-900/50 lg:hidden"></div><aside id="sidebar" class="fixed inset-y-0 z-50 lg:top-0 lg:left-0 bg-base-100 lg:z-50 w-72 dark:bg-base-700 transform -translate-x-full transition-transform duration-300 ease-in-out lg:translate-x-0"><div class="flex flex-col h-full bg-white border-r lg:ml-1 lg:border lg:rounded-tl-xl border-base-200 dark:border-base-800 lg:mt-1 dark:bg-base-900"><div class="flex items-center justify-between px-8 h-14"><a href="/" class="flex items-center space-x-2 text-base-900 dark:text-white"><svg class="size-4" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="100" cy="100" r="100" fill="currentColor"></circle><circle cx="133.333" cy="59.2591" r="14.8148" fill="currentColor" class="fill-accent-500"></circle></svg><span class="text-lg font-semibold">ZeroIndex</span></a><button id="sidebar-close" class="p-2 lg:hidden rounded-md text-base-400 hover:text-base-500 hover:bg-base-200"><span class="sr-only">close sidebar</span><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18