&&t&&r&&(n.style.height=`0`,n.style.opacity=`0`,n.style.transform=`translateY(-0.5rem)`,t.setAttribute(`aria-expanded`,`false`),r.classList.remove(`opacity-100`),r.classList.add(`opacity-0`))}}),a)r.style.height=`0`,r.style.opacity=`0`,r.style.transform=`translateY(-0.5rem)`,n.setAttribute(`aria-expanded`,`false`),i?.classList.remove(`opacity-100`),i?.classList.add(`opacity-0`);else{let e=r.scrollHeight+`px`;r.style.height=e,r.style.opacity=`1`,r.style.transform=`translateY(0)`,n.setAttribute(`aria-expanded`,`true`),i?.classList.add(`opacity-100`),i?.classList.remove(`opacity-0`)}}})},100)}</script><div class="relative" id="section-navigaton"><div class="relative accordion-section group"><div class="absolute inset-y-0 left-0 right-0 bg-base-50 dark:bg-white/2 rounded-md transition-all duration-300 z-0 opacity-0" aria-hidden="true" data-background></div><button class="relative w-full text-left px-4 py-2.5 text-xs font-medium text-base-900 dark:text-white transition-colors duration-200 focus:outline-none z-10" aria-expanded="false" data-accordion-trigger data-fixed="false">Navigaton</button><div class="overflow-hidden accordion-content transition-all duration-500 ease-in-out" style="height: 0; opacity: 0; transform: translateY(-0.5rem);"><nav class="relative z-10 flex flex-col pb-2"><a href="/docs/navigation/sidebar" class="block px-3 ml-4 py-2 text-xs transition-colors duration-200 border-l border-l-base-200 dark:border-l-base-700 text-base-500 dark:text-base-300 hover:text-base-600 dark:hover:text-white">Sidebar</a><a href="/docs/navigation/sidebar-links" class="block px-3 ml-4 py-2 text-xs transition-colors duration-200 border-l border-l-base-200 dark:border-l-base-700 text-base-500 dark:text-base-300 hover:text-base-600 dark:hover:text-white">Sidebar Links</a></nav></div></div></div><div class="relative" id="section-components"><div class="relative accordion-section group"><div class="absolute inset-y-0 left-0 right-0 bg-base-50 dark:bg-white/2 rounded-md transiti