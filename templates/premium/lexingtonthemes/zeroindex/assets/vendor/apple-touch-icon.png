        Buy ZeroIndex
      </a></div></div></aside><script type="module">var e=document.getElementById(`sidebar`),t=document.getElementById(`sidebar-backdrop`),n=document.getElementById(`mobile-menu-toggle`),r=document.getElementById(`sidebar-close`);function i(){e?.classList.remove(`-translate-x-full`),t?.classList.remove(`hidden`),document.body.classList.add(`menu-open`)}function a(){e?.classList.add(`-translate-x-full`),t?.classList.add(`hidden`),document.body.classList.remove(`menu-open`)}n?.addEventListener(`click`,i),r?.addEventListener(`click`,a),t?.addEventListener(`click`,a),(e?.querySelectorAll(`a`))?.forEach(e=>{e.addEventListener(`click`,()=>{window.innerWidth<1024&&a()})}),window.addEventListener(`resize`,()=>{window.innerWidth>=1024&&a()});</script><!-- Main content --><main class="flex-1 min-w-0 bg-white lg:pl-72 lg:mr-1 dark:bg-base-900 lg:border-r lg:border-base-200 dark:border-base-800"><!-- Desktop header --><header class="fixed top-0 right-0 z-50 hidden w-auto lg:block left-72 bg-base-100 dark:bg-base-700"><div class="flex items-center justify-between gap-4 lg:mt-1 lg:mr-1 border-t lg:border-r lg:rounded-tr-xl px-4 py-2.5 border-b border-base-200 dark:border-base-800 bg-white dark:bg-base-900"><div class="w-full max-w-48"><!-- Trigger Button --><button onclick="document.getElementById('search-modal-desktop').classList.remove('hidden')" class="flex items-center justify-between w-full px-4 py-2 text-xs leading-tight align-middle bg-white border border-transparent dark:bg-base-900 transition duration-300 ease-in-out focus:z-10 h-9 rounded-md text-base-500 ring-1 ring-base-200 dark:ring-base-800 placeholder-base-400 focus:border-accent-500 focus:ring-2 focus:ring-accent-100 focus:outline-none shadow-sm focus:ring-offset-white dark:focus:ring-offset-base-900"><div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon size-4" slot="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path><path d="M21 21l-6 -6"></path></svg><span>Search docs</span></div><kbd class="hidden ml-4 text-sm sm:inline-block text-base-400 dark:text-base-500"><div class="flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="icon size-4" slot="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M7 9a2 2 0 1 1 2 -2v10a2 2 0 1 1 -2 -2h10a2 2 0 1 1 -2 2v-10a2 2 0 1 1 2 2h-10"></path></svg>K</div></kbd></button><!-- Modal --><div id="search-modal-desktop" class="fixed inset-0 flex items-start justify-center hidden p-6 z-60 bg-black/40 backdrop-blur"><!-- Click-outside area --><div class="absolute inset-0" onclick="document.getElementById('search-modal-desktop').classList.add('hidden')"></div><!-- Modal content --><div class="relative z-50 w-full max-w-md mt-24" onclick="event.stopPropagation()"><!--
      // In case you want  a close button.
      // But it's not necessary, the modal can be closed by clicking outside of it or pressing the ESC key.
   Close button
   <Button
   iconOnly
   size="xs"
   variant="muted"
   class="hidden ml-auto"
   onclick={`document.getElementById('${modalId}').classList.add('hidden')`}
   >
   <RoundedX slot="icon" size="sm" />
  </Button>
  --><!-- Search Input --><div class="relative w-full bg-white dark:bg-base-900 rounded-md"><input id="search-input-desktop" type="text" autofocus placeholder="Search documentation..." class="block w-full py-2 pl-10 text-xs leading-tight align-middle bg-white border border-transparent dark:bg-base-900 transition duration-300 ease-in-out focus:z-10 h-9 rounded-md text-base-500 ring-1 ring-base-200 dark:ring-base-800 placeholder-base-400 focus:border-accent-500 focus:ring-2 focus:ring-accent-100 focus:outline-none shadow-sm focus:ring-offset-white dark:focus:ring-offset-base-900"><div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon size-4 text-base-400" slot="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path><path d="M21 21l-6 -6"></path></svg></div></div><!-- Results --><div id="search-results-desktop" class="flex flex-col w-full overflow-y-auto bg-white dark:bg-base-800 max-h-80 rounded-b-md scrollbar-hide focus:outline-none space-y-1 focus:ring-2 focus:ring-accent-500"></div></div></div><script>(function(){const docs = [{"title":"Accordion","content":"Expandable section UI using native \u003cdetails> for accessibility and progressive enhancement.","category":"components","url":"/docs/components/accordion"},{"title":"Alert","content":"Contextual alert banners for feedback, messaging, or inline warnings.","category":"components","url":"/docs/components/alerts"},{"title":"Badge","content":"Small, contextual indicators for labeling, categorizing, or status messaging.","category":"components","url":"/docs/components/badges"},{"title":"Button","content":"A flexible button component with multiple variants, sizes, and icon support for ZeroIndex","category":"components","url":"/docs/components/buttons"},{"title":"Tabs","content":"An accessible tab interface with buttons and panels for switching between related content.","category":"components","url":"/docs/components/tabs"},{"title":"Text","content":"A flexible typography component for semantic text with custom sizing and styling in ZeroIndex.","category":"components","url":"/docs/components/typography"},{"title":"Wrapper","content":"A utility layout component for wrapping content with standard or prose-style layouts.","category":"components","url":"/docs/components/wrappers"},{"title":"Introduction","content":"Welcome to our documentation. Learn how to get started quickly.","category":"getting-started","url":"/docs/getting-started/introduction"},{"title":"Quick Start Guide","content":"Get up and running in just a few minutes with this quick start guide.","category":"getting-started","url":"/docs/getting-started/quick-start"},{"title":"Frequently Asked Questions","content":"Answers to common questions about using and contributing to our documentation.","category":"help","url":"/docs/help/faq"},{"title":"Sidebar","content":"Understanding the sidebar","category":"navigation","url":"/docs/navigation/sidebar"},{"title":"Sidebar Links","content":"Understanding the sidebar accordion links","category":"navigation","url":"/docs/navigation/sidebar-links"},{"title":"Shiki Code Highlighting","content":"How syntax highlighting and styling works in ZeroIndex","category":"shiki","url":"/docs/shiki/code-highlighter"},{"title":"Shiki anotations usage examples","content":"Simple examples to get you started with basic functionality.","category":"shiki","url":"/docs/shiki/shiki-examples"}];
const inputId = "search-input-desktop";
const resultsId = "search-results-desktop";
const modalId = "search-modal-desktop";

  if (!window.fuseLoaded) {
    const script = document.createElement("script");
    script.src = "https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js";
    script.onload = () => {
      window.fuseLoaded = true;
      window.dispatchEvent(new Event("fuseReady"));
    };
    document.head.appendChild(script);
  }
  function initializeSearch() {
    if (typeof Fuse === "undefined") {
      window.addEventListener("fuseReady", initializeSearch, { once: true });
      return;
    }
    const searchInput = document.getElementById(inputId);
    const resultsContainer = document.getElementById(resultsId);
    const modal = document.getElementById(modalId);
    if (!searchInput || !resultsContainer || !modal) return;
    if (searchInput.dataset.initialized) return;
    searchInput.dataset.initialized = "true";
    const fuse = new Fuse(docs, {
      keys: ["title", "content", "category"],
      threshold: 0.3,
      includeMatches: true,
    });
    function highlightMatches(text, matches = [], key = "") {
      if (!matches || !text) return text;
      const relevant = matches.find((match) => match.key === key);
      if (!relevant || !relevant.indices) return text;
      const indices = [...relevant.indices];
      let result = "";
      let lastIndex = 0;
      for (const [start, end] of indices) {
        result += text.slice(lastIndex, start);
        result += `<mark class="font-medium text-accent-600 bg-accent-50 dark:bg-base-700 dark:text-accent-300">${text.slice(start, end + 1)}</mark>`;
        lastIndex = end + 1;
      }
      result += text.slice(lastIndex);
      return result;
    }
    function renderResults(results, query) {
      if (!query.trim()) {
        resultsContainer.innerHTML = "";
        return;
      }
      if (results.length === 0) {
        resultsContainer.innerHTML = `<div class="block p-4 hover:bg-base-50 text-base-900 dark:text-white dark:hover:bg-base-700  transition-colors">No results for "${query}"</div>`;
      } else {
        resultsContainer.innerHTML = results

          .map((result) => {
            const { title, content, category, url } = result.item;
            const matches = result.matches;
            return `
              <a href="${url}" class="block p-4 hover:bg-base-50 transition-colors dark:hover:bg-base-700">
                <div class="text-sm font-medium text-base-900 dark:text-white">${highlightMatches(title, matches, "title")}</div>
                <div class="mt-1 text-xs capitalize text-base-500 dark:text-base-300">${category}</div>
                <div class="mt-1 text-sm text-base-600 line-clamp-2 dark:text-base-300">${highlightMatches(content, matches, "content")}</div>
              </a>
            `;
          })
          .join("");
      }
    }
    searchInput.addEventListener("input", (e) => {
      const query = e.target.value;
      const results = query.trim() ? fuse.search(query) : [];
      renderResults(results, query);
    });
    searchInput.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        modal.classList.add("hidden");
      }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        modal.classList.add("hidden");
      }
    });
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeSearch);
  } else {
    initializeSearch();
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeSearch);
  } else {
    initializeSearch();
  }

  // CMD+K / CTRL+K shortcut here 👇
  document.addEventListener("keydown", (e) => {
    const isMac = navigator.platform.toUpperCase().indexOf("MAC") >= 0;
    const openKeys = (isMac && e.metaKey) || (!isMac && e.ctrlKey);

    if (openKeys && e.key.toLowerCase() === "k") {
      e.preventDefault();
      const modal = document.getElementById(modalId);
      const input = document.getElementById(inputId);
      if (modal && input) {
        modal.classList.remove("hidden");
        setTimeout(() => input.focus(), 10);
      }
    }
  });
})();</script></div><div class="flex flex-col ml-auto gap-2 md:gap-4 md:flex-row"><a href="https://buy.polar.sh/polar_cl_MOD8VbnH7TZZ58sMoFCNmoJeM1mV2DeU53Jsw1NBrY6" class="text-2xl  md:text-sm hover:text-base-600 text-base-500 dark:text-base-400 dark:hover:text-base-200 transition-colors">Buy Zeroindex</a><a href="/system/overview" class="text-2xl  md:text-sm hover:text-base-600 text-base-500 dark:text-base-400 dark:hover:text-base-200 transition-colors">Overview</a><a href="/blog/" class="text-2xl  md:text-sm hover:text-base-600 text-base-500 dark:text-base-400 dark:hover:text-base-200 transition-colors">Blog</a><a href="/sign-in" class="text-2xl  md:text-sm hover:text-base-600 text-base-500 dark:text-base-400 dark:hover:text-base-200 transition-colors">sign in</a></div><div class="inline-flex items-center bg-base-100 dark:bg-base-800 rounded-full p-0.5 transition-colors duration-200 gap-1 " data-theme-toggle-container><!-- System/Auto Button --><button class="flex items-center font-medium justify-center transition-all rounded-full duration-300 focus:ring-2 focus:ring-none focus:ring-offset-1 focus:ring-offset-white dark:focus:ring-offset-base-900 text-base-900 bg-base-100 hover:bg-base-100 focus:ring-base-100 dark:text-white dark:bg-base-800 dark:hover:bg-base-700 dark:focus:ring-base-800 size-6 py-2 text-xs" data-theme-option="system" role="radio" aria-checked="false" aria-label="Use system theme" title="System theme"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon size-3" slot="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 5a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1v-10z"></path><path d="M7 20h10"></path><path d="M9 16v4"></path><path d="M15 16v4"></path></svg></button><!-- Light Button --><button class="flex items-center font-medium justify-center transition-all rounded-full duration-