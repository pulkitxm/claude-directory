[
  {
    "trigger": "[aria-controls=\"search-modal\"]",
    "delta": {
      "visible": true,
      "focus": "modal-search"
    }
  },
  {
    "trigger": "Escape",
    "delta": {
      "searchVisible": true
    }
  },
  {
    "trigger": "[for=\"light-switch\"]",
    "delta": {
      "dark": true,
      "stored": "true"
    }
  },
  {
    "trigger": "[aria-haspopup=\"true\"]",
    "delta": {
      "before": "true",
      "after": "false"
    }
  },
  {
    "trigger": "scroll to final article section",
    "delta": {
      "activeText": "The basics"
    }
  },
  {
    "trigger": "[aria-controls=\"sidebar\"]",
    "delta": {
      "sidebarVisible": true,
      "expanded": "true"
    }
  }
]
